<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>

    <!--
      产品信息。原先完全没有版本号，「设置 → 关于」无处显示，
      出问题时也无法确认用户跑的是哪一版。

      v1.2.0：软件更名 XAssistant → Keyboard Assistant。
      注意 RootNamespace 仍保持 XAssistant —— 命名空间重命名会牵动全部源文件，
      收益仅是"好看"，风险却不小（改漏一处就编译失败）。
      真正对用户可见的是 Product / 窗口标题 / exe 名，这三处已改。
    -->
    <Version>1.2.0</Version>
    <AssemblyName>KeyboardAssistant</AssemblyName>
    <Product>Keyboard Assistant</Product>
    <AssemblyTitle>Keyboard Assistant</AssemblyTitle>
    <Company>YYiChen</Company>
    <Description>本机输入与使用情况记录工具（键盘 / 鼠标 / 使用时长统计）</Description>

    <!--
      DPI 感知与应用清单（计划 A7）。
      PerMonitorV2（多显示器不同缩放比例下文字不模糊）与 asInvoker
      （明确以普通用户权限运行）都在 app.manifest 里声明 ——
      WPF 的 DPI 感知由清单控制，不是通过 MSBuild 属性。
    -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!--
      抑制 WFO0003。该警告建议把高 DPI 设置从 manifest 移到
      ApplicationHighDpiMode 属性 —— 但那是 WinForms 的做法，只对
      System.Windows.Forms.Application 生效。本项目主要用 WPF
      （启用 UseWindowsForms 仅为了托盘 NotifyIcon），
      WPF 的 DPI 感知必须由 manifest 的 dpiAwareness 声明，
      按该建议改反而会丢失 PerMonitorV2。
    -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
  </ItemGroup>

  <!--
    图标需要同时以两种方式引入：
      · <ApplicationIcon>（见上方 PropertyGroup）—— 写进 exe 的 PE 资源，
        决定文件在资源管理器里显示的图标。
      · <Resource>（此处）—— 打包进 WPF 程序集，供 Window.Icon 通过
        pack URI 引用。
    只配置前者时，窗口在任务栏上会显示系统默认占位图标 ——
    这正是「任务栏没有图标」的原因。
  -->
  <ItemGroup>
    <Resource Include="Assets\app-icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="XAssistant.Service\**" />
    <EmbeddedResource Remove="XAssistant.Service\**" />
    <None Remove="XAssistant.Service\**" />
    <Page Remove="XAssistant.Service\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.7" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
    <PackageReference Include="System.Management" Version="9.0.0" />
  </ItemGroup>
</Project>
