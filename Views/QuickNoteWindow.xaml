<Window
  x:Class="XAssistant.Views.QuickNoteWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="灵感速记"
  WindowStyle="None"
  ResizeMode="NoResize"
  Topmost="True"
  ShowInTaskbar="False"
  WindowStartupLocation="Manual"
  Background="{StaticResource Brush.Surface}"
  FontFamily="{StaticResource Font.Family}">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </Window.Resources>

  <!--  颜色统一改用设计令牌，不再硬编码  -->
  <Border
    BorderBrush="{StaticResource Brush.Border.Strong}"
    BorderThickness="1">
    <Grid Margin="14,10,14,10">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!--  标题栏：窗口名 + 关闭按钮  -->
      <Grid
        Grid.Row="0"
        Height="22"
        Margin="0,0,0,8">
        <TextBlock
          VerticalAlignment="Center"
          Foreground="{StaticResource Brush.Text.Primary}"
          Style="{StaticResource Text.BodyStrong}"
          Text="灵感速记" />
        <Button
          x:Name="CloseButton"
          Width="20"
          Height="20"
          Padding="0"
          HorizontalAlignment="Right"
          VerticalAlignment="Top"
          Background="Transparent"
          BorderThickness="0"
          Click="CloseButton_Click"
          Content="✕"
          Cursor="Hand"
          FontSize="12"
          Foreground="{StaticResource Brush.Text.Secondary}"
          ToolTip="关闭（不保存）" />
      </Grid>

      <!--  来源行：唤起瞬间的前台窗口标题，超长省略，悬停可看全文；无来源时隐藏  -->
      <TextBlock
        Grid.Row="1"
        Margin="0,0,0,8"
        Foreground="{StaticResource Brush.Text.Tertiary}"
        Style="{StaticResource Text.Caption}"
        Text="{Binding Source}"
        TextTrimming="CharacterEllipsis"
        ToolTip="{Binding Source}"
        Visibility="{Binding HasSource, Converter={StaticResource BoolToVisibility}}" />

      <!--  正文输入：多行、自动聚焦、Enter 换行  -->
      <TextBox
        x:Name="ContentBox"
        Grid.Row="2"
        Padding="4"
        AcceptsReturn="True"
        AcceptsTab="True"
        BorderBrush="{StaticResource Brush.Border.Strong}"
        FontSize="14"
        Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}"
        TextWrapping="Wrap"
        VerticalScrollBarVisibility="Auto" />

      <!--  保存失败提示：内容保留，可重试  -->
      <TextBlock
        Grid.Row="3"
        Margin="0,8,0,0"
        Foreground="{StaticResource Brush.Error}"
        Style="{StaticResource Text.Caption}"
        Text="{Binding ErrorMessage}"
        TextWrapping="Wrap"
        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />

      <!--  底部快捷键提示  -->
      <TextBlock
        Grid.Row="4"
        Margin="0,8,0,0"
        HorizontalAlignment="Right"
        Foreground="{StaticResource Brush.Text.Tertiary}"
        Style="{StaticResource Text.Caption}"
        Text="Ctrl+Enter 保存　·　Esc / ✕ 取消" />
    </Grid>
  </Border>
</Window>
