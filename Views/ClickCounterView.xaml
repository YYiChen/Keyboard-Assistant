<UserControl
  x:Class="XAssistant.Views.ClickCounterView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:vm="clr-namespace:XAssistant.ViewModels"
  d:DataContext="{d:DesignInstance Type=vm:ClickCounterViewModel}"
  d:DesignHeight="700"
  d:DesignWidth="1000"
  mc:Ignorable="d">

  <!--
    本页原先自带一整套硬编码颜色的局部样式（#F0F0F0 / #0078D4 / Gray 阴影），
    与设计系统并行存在 —— 这正是"各页风格不统一"的来源。
    现已全部移除，改用 Themes/Controls.xaml 中的共享令牌与样式。
  -->

  <ScrollViewer
    HorizontalScrollBarVisibility="Disabled"
    VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24">

      <!--  ══════════ 标题 ══════════  -->
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Style="{StaticResource Text.Title}" Text="鼠标点击" />
          <TextBlock
            Margin="0,4,0,0"
            Style="{StaticResource Text.Secondary}"
            Text="左键 / 中键 / 右键的点击次数与分布。" />
        </StackPanel>
        <StackPanel
          Grid.Column="1"
          VerticalAlignment="Center"
          Orientation="Horizontal">
          <Ellipse
            VerticalAlignment="Center"
            Fill="{Binding MouseRecordingColor}"
            Style="{StaticResource Status.Dot}" />
          <TextBlock
            VerticalAlignment="Center"
            Style="{StaticResource Text.Caption}"
            Text="{Binding MouseRecordingStatus}" />
          <TextBlock
            Margin="10,0,0,0"
            VerticalAlignment="Center"
            Style="{StaticResource Text.Caption}"
            Text="记录开关在「设置」页" />
        </StackPanel>
      </Grid>

      <!--  ══════════ 范围切换 + 日期 ══════════  -->
      <Grid Margin="0,18,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!--  快捷范围  -->
        <Border Grid.Column="0" Style="{StaticResource Segmented}">
          <StackPanel Orientation="Horizontal">
            <RadioButton
              Content="今天"
              GroupName="ClickRange"
              IsChecked="{Binding IsRangeToday}"
              Style="{StaticResource Segmented.Item}" />
            <RadioButton
              Content="昨天"
              GroupName="ClickRange"
              IsChecked="{Binding IsRangeYesterday}"
              Style="{StaticResource Segmented.Item}" />
            <RadioButton
              Content="近 7 天"
              GroupName="ClickRange"
              IsChecked="{Binding IsRangeLast7Days}"
              Style="{StaticResource Segmented.Item}" />
            <RadioButton
              Content="近 30 天"
              GroupName="ClickRange"
              IsChecked="{Binding IsRangeLast30Days}"
              Style="{StaticResource Segmented.Item}" />
          </StackPanel>
        </Border>

        <!--  自定义单日（用箭头即脱离上面四个快捷范围）  -->
        <StackPanel
          Grid.Column="2"
          VerticalAlignment="Center"
          Orientation="Horizontal">
          <Button
            Padding="8,6"
            Command="{Binding PreviousDayCommand}"
            Style="{StaticResource Button.Secondary}"
            ToolTip="前一天">
            <TextBlock
              FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
              FontSize="12"
              Text="&#xE76B;" />
          </Button>
          <TextBlock
            MinWidth="104"
            Margin="10,0"
            VerticalAlignment="Center"
            Style="{StaticResource Text.BodyStrong}"
            Text="{Binding DateDisplayText}"
            TextAlignment="Center" />
          <Button
            Padding="8,6"
            Command="{Binding NextDayCommand}"
            IsEnabled="{Binding CanGoNext}"
            Style="{StaticResource Button.Secondary}"
            ToolTip="后一天">
            <TextBlock
              FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
              FontSize="12"
              Text="&#xE76C;" />
          </Button>
        </StackPanel>
      </Grid>

      <!--  ══════════ 指标卡 ══════════  -->
      <UniformGrid Margin="0,16,0,0" Columns="4">
        <Border
          Margin="0,0,6,0"
          Style="{StaticResource Card.Tint.Blue}">
          <StackPanel>
            <TextBlock
              Style="{StaticResource MetricCard.Label}"
              Text="{Binding RangeLabel, StringFormat='{}{0}总点击'}" />
            <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
              <TextBlock
                Foreground="{StaticResource Brush.Blue.Text}"
                Style="{StaticResource MetricCard.Value}"
                Text="{Binding RangeTotal, StringFormat=N0}" />
              <TextBlock
                Margin="4,0,0,4"
                VerticalAlignment="Bottom"
                Opacity="0.7"
                Style="{StaticResource Text.Caption}"
                Text="次" />
            </StackPanel>
            <TextBlock Style="{StaticResource MetricCard.Sub}" Text="三种按键合计" />
          </StackPanel>
        </Border>

        <Border
          Margin="6,0"
          Style="{StaticResource Card.Tint.Violet}">
          <StackPanel>
            <TextBlock Style="{StaticResource MetricCard.Label}" Text="左键" />
            <TextBlock
              Foreground="{StaticResource Brush.Violet.Text}"
              Style="{StaticResource MetricCard.Value}"
              Text="{Binding RangeLeft, StringFormat=N0}" />
            <TextBlock Style="{StaticResource MetricCard.Sub}" Text="点击 / 选择 / 拖拽" />
          </StackPanel>
        </Border>

        <Border
          Margin="6,0"
          Style="{StaticResource Card.Tint.Green}">
          <StackPanel>
            <TextBlock Style="{StaticResource MetricCard.Label}" Text="中键" />
            <TextBlock
              Foreground="{StaticResource Brush.Green.Text}"
              Style="{StaticResource MetricCard.Value}"
              Text="{Binding RangeMiddle, StringFormat=N0}" />
            <TextBlock Style="{StaticResource MetricCard.Sub}" Text="多为新标签页打开" />
          </StackPanel>
        </Border>

        <Border
          Margin="6,0,0,0"
          Style="{StaticResource Card.Tint.Amber}">
          <StackPanel>
            <TextBlock Style="{StaticResource MetricCard.Label}" Text="右键" />
            <TextBlock
              Foreground="{StaticResource Brush.Amber.Text}"
              Style="{StaticResource MetricCard.Value}"
              Text="{Binding RangeRight, StringFormat=N0}" />
            <TextBlock Style="{StaticResource MetricCard.Sub}" Text="呼出上下文菜单" />
          </StackPanel>
        </Border>
      </UniformGrid>

      <!--  ══════════ 构成比例 ══════════  -->
      <Border Margin="0,16,0,24" Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Style="{StaticResource Text.SectionHeader}" Text="按键构成" />
          <TextBlock
            Margin="0,2,0,0"
            Style="{StaticResource Text.Caption}"
            Text="三种按键在所选范围内的占比。" />

          <ItemsControl Margin="0,14,0,0" ItemsSource="{Binding ClickComposition}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,0,0,10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock
                    Grid.Column="0"
                    Style="{StaticResource Text.Body}"
                    Text="{Binding Name}" />
                  <ProgressBar
                    Grid.Column="1"
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    Maximum="100"
                    Style="{StaticResource Viz.Bar}"
                    Value="{Binding Percent}" />
                  <TextBlock
                    Grid.Column="2"
                    Width="78"
                    Style="{StaticResource Viz.RankValue}"
                    Text="{Binding ValueText}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
