<Window
  x:Class="XAssistant.Views.ToastWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="提示"
  WindowStyle="None"
  AllowsTransparency="True"
  Background="Transparent"
  Topmost="True"
  ShowInTaskbar="False"
  ShowActivated="False"
  Focusable="False"
  SizeToContent="WidthAndHeight">
  <!--  颜色统一改用设计令牌  -->
  <Border
    x:Name="Root"
    Padding="14,10"
    Background="{StaticResource Brush.Surface}"
    BorderBrush="{StaticResource Brush.Border.Strong}"
    BorderThickness="1"
    CornerRadius="{StaticResource Radius.Medium}"
    MouseLeftButtonUp="Root_MouseLeftButtonUp">
    <Border.Effect>
      <DropShadowEffect
        BlurRadius="14"
        Direction="270"
        Opacity="0.14"
        ShadowDepth="3"
        Color="#0F172A" />
    </Border.Effect>
    <StackPanel Orientation="Horizontal">
      <TextBlock
        Margin="0,0,8,0"
        VerticalAlignment="Center"
        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
        FontSize="14"
        Foreground="{StaticResource Brush.Success}"
        Text="&#xE73E;" />
      <TextBlock
        x:Name="MessageText"
        MaxWidth="300"
        VerticalAlignment="Center"
        Foreground="{StaticResource Brush.Text.Primary}"
        Style="{StaticResource Text.Body}"
        TextWrapping="Wrap" />
    </StackPanel>
  </Border>
</Window>
