<UserControl
  x:Class="XAssistant.Views.UsageView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:vm="clr-namespace:XAssistant.ViewModels"
  d:DataContext="{d:DesignInstance Type=vm:UsageViewModel}"
  d:DesignHeight="700"
  d:DesignWidth="1000"
  mc:Ignorable="d">

  <ScrollViewer
    HorizontalScrollBarVisibility="Disabled"
    VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24">

      <!--  ══════════ 标题 ══════════  -->
      <TextBlock Style="{StaticResource Text.Title}" Text="电脑使用" />
      <TextBlock
        Margin="0,4,0,0"
        Style="{StaticResource Text.Secondary}"
        Text="今天在电脑前的时间分布与使用节奏。" />

      <!--  时间范围快捷切换  -->
      <Border Margin="0,16,0,0" Style="{StaticResource Segmented}">
        <StackPanel Orientation="Horizontal">
          <RadioButton
            Content="今天"
            GroupName="UsageRange"
            IsChecked="{Binding IsRangeToday}"
            Style="{StaticResource Segmented.Item}" />
          <RadioButton
            Content="昨天"
            GroupName="UsageRange"
            IsChecked="{Binding IsRangeYesterday}"
            Style="{StaticResource Segmented.Item}" />
          <RadioButton
            Content="近 7 天"
            GroupName="UsageRange"
            IsChecked="{Binding IsRangeLast7Days}"
            Style="{StaticResource Segmented.Item}" />
          <RadioButton
            Content="近 30 天"
            GroupName="UsageRange"
            IsChecked="{Binding IsRangeLast30Days}"
            Style="{StaticResource Segmented.Item}" />
        </StackPanel>
      </Border>

      <!--  ══════════ 指标卡 ══════════  -->
      <!--
        四个淡色卡片：用不同色系的极淡底做区块区分，
        解决"整屏全是白色、各块糊在一起"的问题。
        饱和色只出现在数值与数据条上。
      -->
      <UniformGrid Margin="0,18,0,0" Columns="4">
        <Border
          Margin="0,0,6,0"
          Style="{StaticResource Card.Tint.Blue}">
          <StackPanel>
            <TextBlock
              Style="{StaticResource MetricCard.Label}"
              Text="{Binding RangeLabel, StringFormat='{}{0}使用时长'}" />
            <TextBlock
              Foreground="{StaticResource Brush.Blue.Text}"
              Style="{StaticResource MetricCard.Value}"
              Text="{Binding TodayUsageText}"
              TextTrimming="CharacterEllipsis" />
            <TextBlock Style="{StaticResource MetricCard.Sub}" Text="{Binding DataSourceNote}" />
          </StackPanel>
        </Border>

        <Border
          Margin="6,0"
          Style="{StaticResource Card.Tint.Violet}">
          <StackPanel>
            <TextBlock Style="{StaticResource MetricCard.Label}" Text="活跃段数" />
            <TextBlock
              Foreground="{StaticResource Brush.Violet.Text}"
              Style="{StaticResource MetricCard.Value}"
              Text="{Binding TodaySegmentCount}" />
            <TextBlock Style="{StaticResource MetricCard.Sub}" Text="间隔超 5 分钟即算新的一段" />
          </StackPanel>
        </Border>

        <Border
          Margin="6,0"
          Style="{StaticResource Card.Tint.Green}">
          <StackPanel>
            <TextBlock Style="{StaticResource MetricCard.Label}" Text="最长连续" />
            <TextBlock
              Foreground="{StaticResource Brush.Green.Text}"
              Style="{StaticResource MetricCard.Value}"
              Text="{Binding LongestSegmentText}"
              TextTrimming="CharacterEllipsis" />
            <TextBlock Style="{StaticResource MetricCard.Sub}" Text="单段不被打断的时长" />
          </StackPanel>
        </Border>

        <Border
          Margin="6,0,0,0"
          Style="{StaticResource Card.Tint.Amber}">
          <StackPanel>
            <TextBlock Style="{StaticResource MetricCard.Label}" Text="平均每段" />
            <TextBlock
              Foreground="{StaticResource Brush.Amber.Text}"
              Style="{StaticResource MetricCard.Value}"
              Text="{Binding AverageSegmentText}"
              TextTrimming="CharacterEllipsis" />
            <TextBlock Style="{StaticResource MetricCard.Sub}" Text="今日各段时长的平均" />
          </StackPanel>
        </Border>
      </UniformGrid>

      <!--  ══════════ 今日活跃时段 ══════════  -->
      <Border Margin="0,16,0,0" Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock
            Style="{StaticResource Text.SectionHeader}"
            Text="{Binding RangeLabel, StringFormat='{}{0}活跃时段'}" />
          <TextBlock
            Margin="0,2,0,0"
            Style="{StaticResource Text.Caption}"
            Text="每根柱代表一小时，高度表示该小时内的输入活动量。" />

          <ItemsControl Margin="0,16,0,0" ItemsSource="{Binding HourlyBars}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Rows="1" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel VerticalAlignment="Bottom">
                  <Border
                    Margin="2,0"
                    HorizontalAlignment="Stretch">
                    <Border.Style>
                      <Style BasedOn="{StaticResource Viz.SparkBar}" TargetType="Border">
                        <Setter Property="Height" Value="{Binding Height}" />
                        <Setter Property="Width" Value="Auto" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding HasData}" Value="False">
                            <Setter Property="Height" Value="2" />
                            <Setter Property="Background" Value="{StaticResource Brush.Chart.Track}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                  </Border>
                  <TextBlock
                    Margin="0,6,0,0"
                    HorizontalAlignment="Center"
                    Style="{StaticResource Text.Caption}"
                    Text="{Binding Label}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!--  ══════════ 近 7 日趋势 ══════════  -->
      <Border Margin="0,16,0,0" Style="{StaticResource Card}">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Style="{StaticResource Text.SectionHeader}" Text="近 7 日使用时长" />
              <TextBlock
                Margin="0,2,0,0"
                Style="{StaticResource Text.Caption}"
                Text="柱高表示当天时长，↑↓ 为相对前一天的变化。" />
            </StackPanel>
            <StackPanel
              Grid.Column="1"
              VerticalAlignment="Center"
              Orientation="Horizontal">
              <TextBlock
                VerticalAlignment="Bottom"
                Style="{StaticResource Text.Caption}"
                Text="合计" />
              <TextBlock
                Margin="6,0,0,0"
                Style="{StaticResource Text.Metric}"
                Text="{Binding WeeklyTotalText}" />
            </StackPanel>
          </Grid>

          <ItemsControl Margin="0,18,0,0" ItemsSource="{Binding WeeklyDurations}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Rows="1" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel VerticalAlignment="Bottom">
                  <!--  时长文本  -->
                  <TextBlock
                    Margin="0,0,0,6"
                    HorizontalAlignment="Center"
                    Style="{StaticResource Text.Caption}"
                    Text="{Binding DurationText}" />
                  <Border
                    Margin="8,0"
                    HorizontalAlignment="Stretch">
                    <Border.Style>
                      <Style BasedOn="{StaticResource Viz.SparkBar}" TargetType="Border">
                        <Setter Property="Height" Value="{Binding Height}" />
                        <Setter Property="Width" Value="Auto" />
                        <Setter Property="Background" Value="{StaticResource Brush.Chart.Muted}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsToday}" Value="True">
                            <Setter Property="Background" Value="{StaticResource Brush.Chart.Primary}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Height}" Value="0">
                            <Setter Property="Height" Value="2" />
                            <Setter Property="Background" Value="{StaticResource Brush.Chart.Track}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                  </Border>
                  <TextBlock
                    Margin="0,6,0,0"
                    HorizontalAlignment="Center"
                    Style="{StaticResource Text.Caption}"
                    Text="{Binding Label}" />
                  <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource Text.Caption}"
                    Text="{Binding DateText}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!--  ══════════ 历史明细 ══════════  -->
      <Border Margin="0,16,0,24" Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Style="{StaticResource Text.SectionHeader}" Text="历史使用时长" />
          <TextBlock
            Margin="0,2,0,0"
            Style="{StaticResource Text.Caption}"
            Text="来自电脑使用追踪服务的原始记录。未安装该服务时此表为空，不影响上方基于输入活动的统计。" />

          <DataGrid
            Margin="0,12,0,0"
            MaxHeight="260"
            ItemsSource="{Binding History}"
            Style="{StaticResource DataGrid.Modern}">
            <DataGrid.Columns>
              <DataGridTextColumn
                Width="120"
                Binding="{Binding Date}"
                Header="日期" />
              <DataGridTextColumn
                Width="160"
                Binding="{Binding FormattedTime}"
                Header="时长（记录值）" />
              <DataGridTextColumn
                Width="160"
                Binding="{Binding FormattedCorrectedTime}"
                Header="修正时长">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding HasDiscrepancy}" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource Brush.Error}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn
                Width="*"
                Binding="{Binding CorrectionReason}"
                Header="修正原因" />
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
