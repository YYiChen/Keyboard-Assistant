<UserControl
  x:Class="XAssistant.Views.HomeView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:vm="clr-namespace:XAssistant.ViewModels"
  d:DataContext="{d:DesignInstance Type=vm:HomeViewModel}"
  d:DesignHeight="700"
  d:DesignWidth="1000"
  mc:Ignorable="d">

  <!--
    首页原先是四个模块各报各的数字（且自带一套硬编码颜色的局部样式），
    看不出「今天整体怎么样」。现在改为「总览 → 趋势 → 状态」三层。
  -->

  <ScrollViewer
    HorizontalScrollBarVisibility="Disabled"
    VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24">

      <!--  ══════════ 标题 ══════════  -->
      <TextBlock Style="{StaticResource Text.Title}" Text="今天" />
      <TextBlock
        Margin="0,4,0,0"
        Style="{StaticResource Text.Secondary}"
        Text="{Binding TodayInputBreakdown, StringFormat='到目前为止共 {0}。'}" />

      <!--  ══════════ 总览指标 ══════════  -->
      <UniformGrid Margin="0,18,0,0" Columns="4">
        <Border
          Margin="0,0,6,0"
          Style="{StaticResource Card.Tint.Blue}">
          <StackPanel>
            <TextBlock Style="{StaticResource MetricCard.Label}" Text="键盘按键" />
            <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
              <TextBlock
                Foreground="{StaticResource Brush.Blue.Text}"
                Style="{StaticResource MetricCard.Value}"
                Text="{Binding KeyTodayPresses, StringFormat=N0}" />
              <TextBlock
                Margin="4,0,0,4"
                VerticalAlignment="Bottom"
                Opacity="0.7"
                Style="{StaticResource Text.Caption}"
                Text="次" />
            </StackPanel>
            <TextBlock Style="{StaticResource MetricCard.Sub}" Text="今日累计" />
          </StackPanel>
        </Border>

        <Border
          Margin="6,0"
          Style="{StaticResource Card.Tint.Violet}">
          <StackPanel>
            <TextBlock Style="{StaticResource MetricCard.Label}" Text="鼠标点击" />
            <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
              <TextBlock
                Foreground="{StaticResource Brush.Violet.Text}"
                Style="{StaticResource MetricCard.Value}"
                Text="{Binding MouseTodayClicks, StringFormat=N0}" />
              <TextBlock
                Margin="4,0,0,4"
                VerticalAlignment="Bottom"
                Opacity="0.7"
                Style="{StaticResource Text.Caption}"
                Text="次" />
            </StackPanel>
            <TextBlock Style="{StaticResource MetricCard.Sub}" Text="今日累计" />
          </StackPanel>
        </Border>

        <Border
          Margin="6,0"
          Style="{StaticResource Card.Tint.Green}">
          <StackPanel>
            <TextBlock Style="{StaticResource MetricCard.Label}" Text="电脑使用" />
            <TextBlock
              Margin="0,8,0,0"
              Foreground="{StaticResource Brush.Green.Text}"
              Style="{StaticResource MetricCard.Value}"
              Text="{Binding TodayUsageText}"
              TextTrimming="CharacterEllipsis" />
            <TextBlock Style="{StaticResource MetricCard.Sub}" Text="今日活跃时长" />
          </StackPanel>
        </Border>

        <Border
          Margin="6,0,0,0"
          Style="{StaticResource Card.Tint.Amber}">
          <StackPanel>
            <TextBlock Style="{StaticResource MetricCard.Label}" Text="活跃应用" />
            <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
              <TextBlock
                Foreground="{StaticResource Brush.Amber.Text}"
                Style="{StaticResource MetricCard.Value}"
                Text="{Binding TodayAppCount}" />
              <TextBlock
                Margin="4,0,0,4"
                VerticalAlignment="Bottom"
                Opacity="0.7"
                Style="{StaticResource Text.Caption}"
                Text="个" />
            </StackPanel>
            <TextBlock
              Style="{StaticResource MetricCard.Sub}"
              Text="{Binding TopAppName, StringFormat='最多：{0}'}"
              TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Border>
      </UniformGrid>

      <!--  ══════════ 近 7 日活跃趋势 ══════════  -->
      <Border Margin="0,16,0,0" Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Style="{StaticResource Text.SectionHeader}" Text="近 7 日活跃度" />
          <TextBlock
            Margin="0,2,0,0"
            Style="{StaticResource Text.Caption}"
            Text="由键盘与鼠标活动合并推算的每日活跃时长。" />

          <ItemsControl Margin="0,16,0,0" ItemsSource="{Binding WeeklyActivity}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Rows="1" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel VerticalAlignment="Bottom">
                  <TextBlock
                    Margin="0,0,0,6"
                    HorizontalAlignment="Center"
                    Style="{StaticResource Text.Caption}"
                    Text="{Binding DurationText}" />
                  <Border
                    Margin="8,0"
                    HorizontalAlignment="Stretch">
                    <Border.Style>
                      <Style BasedOn="{StaticResource Viz.SparkBar}" TargetType="Border">
                        <Setter Property="Height" Value="{Binding Height}" />
                        <Setter Property="Width" Value="Auto" />
                        <Setter Property="Background" Value="{StaticResource Brush.Chart.Muted}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsToday}" Value="True">
                            <Setter Property="Background" Value="{StaticResource Brush.Chart.Primary}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                  </Border>
                  <TextBlock
                    Margin="0,6,0,0"
                    HorizontalAlignment="Center"
                    Style="{StaticResource Text.Caption}"
                    Text="{Binding Label}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!--  ══════════ 记录状态 ══════════  -->
      <Border Margin="0,16,0,24" Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Style="{StaticResource Text.SectionHeader}" Text="记录状态" />
          <TextBlock
            Margin="0,2,0,0"
            Style="{StaticResource Text.Caption}"
            Text="开关集中在「设置」页；各模块的详细统计见左侧对应页面。" />

          <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel
              Grid.Column="0"
              Orientation="Horizontal">
              <Ellipse
                VerticalAlignment="Center"
                Fill="{Binding KeyRecordingColor}"
                Style="{StaticResource Status.Dot}" />
              <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource Text.Body}"
                Text="键盘记录" />
              <TextBlock
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                Style="{StaticResource Text.Caption}"
                Text="{Binding KeyRecordingStatus}" />
            </StackPanel>

            <StackPanel
              Grid.Column="1"
              Orientation="Horizontal">
              <Ellipse
                VerticalAlignment="Center"
                Fill="{Binding MouseRecordingColor}"
                Style="{StaticResource Status.Dot}" />
              <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource Text.Body}"
                Text="鼠标点击" />
              <TextBlock
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                Style="{StaticResource Text.Caption}"
                Text="{Binding MouseRecordingStatus}" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
