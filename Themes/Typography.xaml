<!--
    排版层级

    字体族用回退链：Segoe UI Variable（Windows 11 自带，比旧 Segoe UI 更现代）
    → Segoe UI（Win10 回退）→ Microsoft YaHei UI（中文）。
    Linear 用 Inter Variable；本项目不引入外部字体依赖，用系统自带的
    Segoe UI Variable 达到相近观感。

    ⚠ WPF 限制：TextBlock 没有 letter-spacing 属性，因此 Linear 规范里
    「大字号用负字距」这一条无法实现（Glyphs 元素可以精细控制字距，
    但它要求把文本转成字形索引，不适合普通动态文本）。
    这里改用「字号 + 字重 + 颜色」三者拉开层级作为补偿。

    用法：<TextBlock Style="{StaticResource Text.SectionHeader}" />
-->
<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!--  ==================== 字体族 ====================  -->
  <FontFamily x:Key="Font.Family">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, Microsoft YaHei</FontFamily>
  <FontFamily x:Key="Font.Family.Mono">Cascadia Mono, Consolas, Courier New, monospace</FontFamily>

  <!--  ==================== 字号阶梯 ====================  -->
  <sys:Double x:Key="Font.Size.MetricLarge">28</sys:Double>
  <sys:Double x:Key="Font.Size.Metric">20</sys:Double>
  <sys:Double x:Key="Font.Size.Title">20</sys:Double>
  <sys:Double x:Key="Font.Size.SectionHeader">14</sys:Double>
  <sys:Double x:Key="Font.Size.Body">13</sys:Double>
  <sys:Double x:Key="Font.Size.Caption">11</sys:Double>
  <sys:Double x:Key="Font.Size.Mono">12</sys:Double>

  <!--  ==================== 语义化文本样式 ====================  -->

  <!--  页面级大数字  -->
  <Style x:Key="Text.MetricLarge" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.MetricLarge}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
  </Style>

  <!--  卡片内数字  -->
  <Style x:Key="Text.Metric" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.Metric}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
  </Style>

  <!--  卡片内的小号强调文本（如"用时最多的应用名"）  -->
  <Style x:Key="Text.MetricSmall" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <!--  数字旁的单位（"次"、"分钟"）  -->
  <Style x:Key="Text.MetricUnit" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Tertiary}" />
    <Setter Property="Margin" Value="4,0,0,3" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
  </Style>

  <!--  页面标题  -->
  <Style x:Key="Text.Title" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.Title}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!--  卡片 / 分组标题  -->
  <Style x:Key="Text.SectionHeader" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.SectionHeader}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
  </Style>

  <!--  正文  -->
  <Style x:Key="Text.Body" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!--  需强调的正文（Medium 而非 Bond，避免与颜色叠加过度强调）  -->
  <Style x:Key="Text.BodyStrong" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!--  次要说明  -->
  <Style x:Key="Text.Secondary" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!--  标签 / 单位 / 时间戳  -->
  <Style x:Key="Text.Caption" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.Caption}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Tertiary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!--  等宽：路径、类名、版本号  -->
  <Style x:Key="Text.Mono" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Family.Mono}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.Mono}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
  </Style>
</ResourceDictionary>
