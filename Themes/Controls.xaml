<!--
    控件样式

    提供键控样式；不使用隐式样式（除 Window 图标外），
    避免一次性改变所有同类控件外观而导致布局回归 —— 改为「迁移到哪页、哪页才换装」。

    依赖：需在 App.xaml 中于 Palette.xaml、Typography.xaml 之后合并
    （本文件通过 StaticResource 引用前两者的令牌，顺序不能乱）。
-->
<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--  ══════════════ 侧边栏导航 ══════════════  -->

  <Style x:Key="Nav.Item" TargetType="ListBoxItem">
    <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border
            x:Name="Root"
            Margin="8,1"
            Padding="12,9"
            Background="Transparent"
            CornerRadius="{StaticResource Radius.Medium}">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.Hover}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.Selected}" />
              <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
              <Setter Property="FontWeight" Value="Medium" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Nav.ListBox" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource Nav.Item}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
  </Style>

  <Style x:Key="Nav.Icon" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,0,12,0" />
    <!--  不设 Foreground：继承导航项着色，选中时随之变主色  -->
  </Style>

  <!--  ══════════════ 按钮 ══════════════  -->

  <Style x:Key="Button.Base" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Padding" Value="{StaticResource Padding.Control}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <Style
    x:Key="Button.Primary"
    BasedOn="{StaticResource Button.Base}"
    TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.OnAccent}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border
            x:Name="Root"
            Padding="{TemplateBinding Padding}"
            Background="{StaticResource Brush.Accent}"
            CornerRadius="{StaticResource Radius.Medium}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.Accent.Hover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.Accent.Pressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.Border}" />
              <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style
    x:Key="Button.Secondary"
    BasedOn="{StaticResource Button.Base}"
    TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border
            x:Name="Root"
            Padding="{TemplateBinding Padding}"
            Background="{StaticResource Brush.Surface}"
            BorderBrush="{StaticResource Brush.Border}"
            BorderThickness="1"
            CornerRadius="{StaticResource Radius.Medium}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.Hover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.Pressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}" />
              <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.Surface.Alt}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    Ghost：无底无框，仅悬停时浮现浅底。
    用于工具栏、次要操作 —— 避免一屏出现太多带框按钮（"按钮海"也是原生感的来源）。
  -->
  <Style
    x:Key="Button.Ghost"
    BasedOn="{StaticResource Button.Base}"
    TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border
            x:Name="Root"
            Padding="{TemplateBinding Padding}"
            Background="Transparent"
            CornerRadius="{StaticResource Radius.Medium}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.Hover}" />
              <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.Pressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--  ══════════════ 开关 Switch ══════════════  -->

  <!--
    替代原生 CheckBox。WPF 默认 CheckBox 是 Windows 95 观感的小方框，
    是"界面不现代"最典型的来源之一。设置页一律使用本样式：
    轨道 40×22 圆角药丸；关闭态灰、开启态主色；滑块 16px 圆形，
    位置切换带 150ms 过渡。

    用法：<ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding X}" />
  -->
  <Style x:Key="Switch" TargetType="ToggleButton">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid Background="Transparent">
            <!--
              轨道是"槽"，不是实心药丸。

              上一版用实心中灰（Brush.Border.Strong）填充整个 40×22 药丸，
              再叠一个 16×16 的白色圆 —— 观感是"灰椭圆上盖了颗白按钮"，
              不像开关。正确做法是：极浅的底 + 1px 边框，
              视觉上形成"凹槽"，滑块嵌在槽里滑动。
            -->
            <Border
              x:Name="Track"
              Background="{StaticResource Brush.Surface.Alt}"
              BorderBrush="{StaticResource Brush.Border.Strong}"
              BorderThickness="1"
              CornerRadius="10" />

            <!--
              滑块比轨道矮一档（12 vs 20），四周留空隙。
              未选中是灰色小圆、选中转白 —— 与 Windows 11 的开关一致，
              比"白圆点"更明确地表达开/关两态。
            -->
            <Ellipse
              x:Name="Thumb"
              Width="12"
              Height="12"
              Margin="4,0,0,0"
              HorizontalAlignment="Left"
              VerticalAlignment="Center"
              Fill="{StaticResource Brush.Text.Tertiary}">
              <Ellipse.RenderTransform>
                <TranslateTransform x:Name="ThumbShift" X="0" />
              </Ellipse.RenderTransform>
            </Ellipse>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{StaticResource Brush.Accent}" />
              <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
              <Setter TargetName="Thumb" Property="Fill" Value="White" />
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <!--  移动距离 = 轨道宽 40 − 左边距 4 − 滑块 12 − 右边距 4 = 20  -->
                    <DoubleAnimation
                      Storyboard.TargetName="ThumbShift"
                      Storyboard.TargetProperty="X"
                      To="20"
                      Duration="0:0:0.15" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation
                      Storyboard.TargetName="ThumbShift"
                      Storyboard.TargetProperty="X"
                      To="0"
                      Duration="0:0:0.15" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsMouseOver" Value="True" />
                <Condition Property="IsChecked" Value="False" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Track" Property="Background" Value="{StaticResource Brush.Hover}" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--  ══════════════ 容器 ══════════════  -->

  <!--
    卡片。

    ⚠ 关键点：页面背景是浅灰（Brush.Background），卡片是纯白 + 阴影，
    卡片因此"浮"在背景之上 —— 这是解决"整屏惨白、毫无层次"的核心手法
    （Vercel / Stripe / Linear 三家共有）。

    阴影用极低透明度（0.05）+ 小偏移：只为产生一点点悬浮感，
    不能重到像浮层。WPF 的 Effect 有一定渲染开销，因此不用大模糊半径。
  -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Large}" />
    <Setter Property="Padding" Value="{StaticResource Padding.Card}" />
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect
          BlurRadius="10"
          Direction="270"
          Opacity="0.05"
          ShadowDepth="1"
          Color="#0F172A" />
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    淡色卡片：无边框、无阴影，靠极淡的有色底做区块区分。
    用于指标卡 —— 让并排的几个指标一眼可分，同时避免整屏只用白色。
    饱和色只出现在文字和数据条上，底色保持很淡，不破坏整体的克制。
  -->
  <Style x:Key="Card.Tint" TargetType="Border">
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Large}" />
    <Setter Property="Padding" Value="16,14" />
  </Style>

  <Style
    x:Key="Card.Tint.Blue"
    BasedOn="{StaticResource Card.Tint}"
    TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Brush.Blue.Tint}" />
  </Style>

  <Style
    x:Key="Card.Tint.Green"
    BasedOn="{StaticResource Card.Tint}"
    TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Brush.Green.Tint}" />
  </Style>

  <Style
    x:Key="Card.Tint.Amber"
    BasedOn="{StaticResource Card.Tint}"
    TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Brush.Amber.Tint}" />
  </Style>

  <Style
    x:Key="Card.Tint.Violet"
    BasedOn="{StaticResource Card.Tint}"
    TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Brush.Violet.Tint}" />
  </Style>

  <Style
    x:Key="Card.Tint.Rose"
    BasedOn="{StaticResource Card.Tint}"
    TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Brush.Rose.Tint}" />
  </Style>

  <!--  指标卡内的标签与数值（配合 Card.Tint.* 使用，文字取对应的深色）  -->
  <Style x:Key="MetricCard.Label" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.Caption}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Opacity" Value="0.75" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="MetricCard.Value" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,6,0,0" />
  </Style>

  <Style x:Key="MetricCard.Sub" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.Caption}" />
    <Setter Property="Opacity" Value="0.65" />
    <Setter Property="Margin" Value="0,4,0,0" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!--  药丸徽标（Vercel 的 pill badge 做法：淡底 + 深字 + 全圆角）  -->
  <Style x:Key="Badge" TargetType="Border">
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="Badge.Text" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.Caption}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>

  <Style x:Key="Divider" TargetType="Border">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{StaticResource Brush.Divider}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <!--  ══════════════ 数据可视化 ══════════════  -->

  <!--
    横向数据条。用 ProgressBar 的自定义模板实现 ——
    ProgressBar 的模板中 PART_Indicator 会被框架按 Value/Maximum 自动设置宽度，
    因此无需自己写 GridLength 转换器即可得到"按比例伸缩"的条形。

    用法：<ProgressBar Style="{StaticResource Viz.Bar}" Value="{Binding Percent}" Maximum="100" />
  -->
  <Style x:Key="Viz.Bar" TargetType="ProgressBar">
    <Setter Property="Height" Value="8" />
    <Setter Property="Minimum" Value="0" />
    <Setter Property="Maximum" Value="100" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Chart.Primary}" />
    <Setter Property="Background" Value="{StaticResource Brush.Chart.Track}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Grid>
            <Border Background="{TemplateBinding Background}" CornerRadius="4" />
            <Border
              x:Name="PART_Indicator"
              HorizontalAlignment="Left"
              Background="{TemplateBinding Foreground}"
              CornerRadius="4" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--  弱化版数据条：用于对比周期（如昨日的占比）  -->
  <Style
    x:Key="Viz.Bar.Muted"
    BasedOn="{StaticResource Viz.Bar}"
    TargetType="ProgressBar">
    <Setter Property="Foreground" Value="{StaticResource Brush.Chart.Muted}" />
    <Setter Property="Height" Value="6" />
  </Style>

  <!--
    迷你柱状图的一根柱。高度由绑定的像素值决定（视图模型按最大值归一化到 0–MaxBarHeight）。
    用法：<Border Style="{StaticResource Viz.SparkBar}" Height="{Binding BarHeight}" />
  -->
  <Style x:Key="Viz.SparkBar" TargetType="Border">
    <Setter Property="Width" Value="10" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="Background" Value="{StaticResource Brush.Chart.Primary}" />
    <Setter Property="CornerRadius" Value="2" />
  </Style>

  <!--  迷你柱状图的零值柱（当天该时段无数据时保留占位，避免"断柱"）  -->
  <Style x:Key="Viz.SparkBar.Zero" TargetType="Border">
    <Setter Property="Width" Value="10" />
    <Setter Property="Height" Value="2" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="Background" Value="{StaticResource Brush.Chart.Track}" />
    <Setter Property="CornerRadius" Value="1" />
  </Style>

  <!--
    排行条的标签列：固定宽度 + 右对齐 + 等宽字体。
    等宽是为了让数值纵向对齐，右对齐是为了让量级差一眼可比。
  -->
  <Style x:Key="Viz.RankLabel" TargetType="TextBlock">
    <Setter Property="Width" Value="72" />
    <Setter Property="TextAlignment" Value="Right" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
  </Style>

  <Style x:Key="Viz.RankValue" TargetType="TextBlock">
    <Setter Property="Width" Value="64" />
    <Setter Property="TextAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Family.Mono}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.Mono}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
  </Style>

  <!--  ══════════════ 记录状态指示 ══════════════  -->

  <Style x:Key="Status.Dot" TargetType="Ellipse">
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="8" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,0,6,0" />
  </Style>

  <!--  ══════════════ 数据表格 ══════════════  -->

  <!--
    WPF 默认 DataGrid 是灰色立体表头 + 四周网格线 + 整行深蓝选中。
    本样式改为：无外框无网格线；表头透明底小号灰字 + 下方 1px 分隔线；
    行高 38、悬停浅灰、选中浅蓝。

    必须重写 Template 而非仅用 Setter —— 默认表头模板的背景是硬编码渐变，
    Setter 对它无效。
  -->
  <Style x:Key="DataGrid.Modern.ColumnHeader" TargetType="DataGridColumnHeader">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Tertiary}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.Caption}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Height" Value="34" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridColumnHeader">
          <Grid>
            <Border
              x:Name="Root"
              Padding="{TemplateBinding Padding}"
              Background="{TemplateBinding Background}"
              BorderBrush="{StaticResource Brush.Divider}"
              BorderThickness="0,0,0,1">
              <ContentPresenter
                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalAlignment="Center" />
            </Border>
            <Thumb
              x:Name="PART_RightHeaderGripper"
              Width="8"
              HorizontalAlignment="Right"
              Cursor="SizeWE"
              Opacity="0">
              <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                  <Border Background="Transparent" />
                </ControlTemplate>
              </Thumb.Template>
            </Thumb>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="DataGrid.Modern.Cell" TargetType="DataGridCell">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridCell">
          <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="DataGrid.Modern.Row" TargetType="DataGridRow">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Height" Value="38" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource Brush.Hover}" />
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="{StaticResource Brush.Selected}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="DataGrid.Modern" TargetType="DataGrid">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="GridLinesVisibility" Value="None" />
    <Setter Property="HeadersVisibility" Value="Column" />
    <Setter Property="RowHeight" Value="38" />
    <Setter Property="AutoGenerateColumns" Value="False" />
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="CanUserAddRows" Value="False" />
    <Setter Property="CanUserDeleteRows" Value="False" />
    <Setter Property="CanUserResizeRows" Value="False" />
    <Setter Property="CanUserReorderColumns" Value="False" />
    <Setter Property="SelectionMode" Value="Single" />
    <Setter Property="SelectionUnit" Value="FullRow" />
    <Setter Property="EnableRowVirtualization" Value="True" />
    <Setter Property="EnableColumnVirtualization" Value="True" />
    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ColumnHeaderStyle" Value="{StaticResource DataGrid.Modern.ColumnHeader}" />
    <Setter Property="CellStyle" Value="{StaticResource DataGrid.Modern.Cell}" />
    <Setter Property="RowStyle" Value="{StaticResource DataGrid.Modern.Row}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
  </Style>

  <!--  数字列：右对齐 + 等宽，便于纵向比对  -->
  <Style
    x:Key="DataGrid.Modern.NumericCell"
    BasedOn="{StaticResource DataGrid.Modern.Cell}"
    TargetType="DataGridCell">
    <Setter Property="HorizontalContentAlignment" Value="Right" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Family.Mono}" />
  </Style>

  <Style
    x:Key="DataGrid.Modern.NumericHeader"
    BasedOn="{StaticResource DataGrid.Modern.ColumnHeader}"
    TargetType="DataGridColumnHeader">
    <Setter Property="HorizontalContentAlignment" Value="Right" />
  </Style>

  <!--  ══════════════ 标签页 ══════════════  -->

  <!--
    下划线指示式标签页（Linear / Stripe 常见做法）。

    WPF 默认 TabControl 是 Windows XP 时代的"立体文件夹"观感：
    灰底渐变的方块、选中项凸起 —— 与扁平现代风格完全冲突。
    这里改为：无边框、纯文字标签、选中项下方 2px 主色指示条。

    注意模板里必须用 <TabPanel IsItemsHost="True"> 承载标签头，
    且内容区要绑 ContentSource="SelectedContent"，否则切换会失效。
  -->
  <Style x:Key="TabItem.Modern" TargetType="TabItem">
    <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Grid>
            <Border
              x:Name="Root"
              Padding="14,8"
              Background="Transparent">
              <ContentPresenter
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                ContentSource="Header" />
            </Border>
            <Border
              x:Name="Indicator"
              Height="2"
              Margin="6,0"
              VerticalAlignment="Bottom"
              Background="Transparent"
              CornerRadius="1" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
              <Setter Property="FontWeight" Value="Medium" />
              <Setter TargetName="Indicator" Property="Background" Value="{StaticResource Brush.Accent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="TabControl.Modern" TargetType="TabControl">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource TabItem.Modern}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabControl">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border
              Grid.Row="0"
              BorderBrush="{StaticResource Brush.Divider}"
              BorderThickness="0,0,0,1">
              <TabPanel
                Margin="0"
                HorizontalAlignment="Left"
                IsItemsHost="True" />
            </Border>
            <ContentPresenter
              Grid.Row="1"
              Margin="0,14,0,0"
              ContentSource="SelectedContent" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--  ══════════════ 下拉框 ══════════════  -->

  <Style x:Key="ComboBoxItem.Modern" TargetType="ComboBoxItem">
    <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border
            x:Name="Root"
            Padding="{TemplateBinding Padding}"
            Background="Transparent">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.Hover}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.Selected}" />
              <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ComboBox.Modern" TargetType="ComboBox">
    <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource ComboBoxItem.Modern}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton
              x:Name="ToggleButton"
              ClickMode="Press"
              Focusable="False"
              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border
                    x:Name="Border"
                    Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Medium}">
                    <TextBlock
                      Margin="0,0,10,0"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                      FontSize="10"
                      Foreground="{StaticResource Brush.Text.Tertiary}"
                      Text="&#xE70D;" />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource Brush.Border.Strong}" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>

            <!--  选中项的显示（不参与命中测试，点击由上面的 ToggleButton 接管）  -->
            <ContentPresenter
              Margin="10,0,28,0"
              HorizontalAlignment="Left"
              VerticalAlignment="Center"
              Content="{TemplateBinding SelectionBoxItem}"
              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
              IsHitTestVisible="False" />

            <Popup
              x:Name="PART_Popup"
              AllowsTransparency="True"
              IsOpen="{TemplateBinding IsDropDownOpen}"
              Placement="Bottom"
              PopupAnimation="Fade">
              <Border
                Margin="0,4,0,0"
                MinWidth="{TemplateBinding ActualWidth}"
                MaxHeight="{TemplateBinding MaxDropDownHeight}"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius.Medium}">
                <Border.Effect>
                  <DropShadowEffect
                    BlurRadius="14"
                    Direction="270"
                    Opacity="0.12"
                    ShadowDepth="3"
                    Color="#0F172A" />
                </Border.Effect>
                <ScrollViewer Margin="0,4">
                  <StackPanel IsItemsHost="True" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--  ══════════════ 分段切换（时间范围选择） ══════════════  -->

  <!--
    分段控件：一组互斥的短选项（今天 / 昨天 / 近一周 / 近一月）。
    用 RadioButton + 同一 GroupName 表达互斥，选中项为白底滑块式高亮，
    整体嵌在一个浅灰容器里 —— 即 iOS / macOS 分段控件与 Linear 的 view switcher 的做法。

    比下拉框更合适：选项少且都是高频切换，摊开成按钮可以一次点击到位，
    不需要"展开→选中"两步。
  -->
  <Style x:Key="Segmented" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Brush.Surface.Alt}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Medium}" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>

  <Style x:Key="Segmented.Item" TargetType="RadioButton">
    <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border
            x:Name="Root"
            Padding="12,5"
            Background="Transparent"
            CornerRadius="{StaticResource Radius.Small}">
            <ContentPresenter
              HorizontalAlignment="Center"
              VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
              <Setter Property="FontWeight" Value="Medium" />
              <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.Surface}" />
              <Setter TargetName="Root" Property="Effect">
                <Setter.Value>
                  <DropShadowEffect
                    BlurRadius="4"
                    Direction="270"
                    Opacity="0.10"
                    ShadowDepth="1"
                    Color="#0F172A" />
                </Setter.Value>
              </Setter>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
