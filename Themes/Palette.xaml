<!--
    调色板

    参考（见 DESIGN.md）：Vercel / Stripe / Linear 三家设计系统。
      · Vercel —— 「阴影即边框」的多层阴影栈；多层次表面（白 / #fafafa / 更深）
      · Stripe —— 冷调中性色（边框与阴影都带蓝，不发灰发脏）；深海军蓝做正文；
                  每个语义色配一个"淡底 + 深字"的组合用于卡片与徽标
      · Linear —— 背景亮度阶梯表达层级；强调色是稀缺资源

    ⚠ 关键修正（2026-10-08）：
    上一版把「页面背景」和「卡片背景」都设成了纯白，导致整屏一片惨白、毫无层次。
    本版改为：页面底用浅灰、卡片用白 —— 卡片自然从背景上"浮"起来，
    这是最直接、也是三家共有的层次手法。

    用法约定：界面中【禁止】再写颜色字面量，一律引用这里的语义化画刷。
-->
<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--  ==================== 中性色阶梯 ====================  -->
  <!--  全部带轻微冷调（参考 Stripe 的蓝调中性色），避免发灰发脏  -->

  <Color x:Key="Color.Neutral.0">#FFFFFFFF</Color>
  <!--  页面背景：浅冷灰，而非纯白 —— 让卡片浮起来  -->
  <Color x:Key="Color.Neutral.5">#FFF6F8FB</Color>
  <!--  次级表面 / 悬停  -->
  <Color x:Key="Color.Neutral.10">#FFF0F3F8</Color>
  <!--  分隔线  -->
  <Color x:Key="Color.Neutral.15">#FFE8ECF2</Color>
  <!--  边框  -->
  <Color x:Key="Color.Neutral.20">#FFDFE4EC</Color>
  <!--  强边框  -->
  <Color x:Key="Color.Neutral.30">#FFC6CDD9</Color>
  <!--  禁用  -->
  <Color x:Key="Color.Neutral.40">#FFA6AEBD</Color>
  <!--  三级文字  -->
  <Color x:Key="Color.Neutral.60">#FF737E92</Color>
  <!--  二级文字  -->
  <Color x:Key="Color.Neutral.75">#FF4A5568</Color>
  <!--  一级文字：带蓝调的近黑（Stripe 的深海军蓝思路），比纯黑有质感  -->
  <Color x:Key="Color.Neutral.95">#FF0F172A</Color>

  <!--  ==================== 主色 ====================  -->
  <Color x:Key="Color.Accent">#FF2563EB</Color>
  <Color x:Key="Color.Accent.Hover">#FF3B82F6</Color>
  <Color x:Key="Color.Accent.Pressed">#FF1D4ED8</Color>
  <Color x:Key="Color.Accent.Tint">#FFEFF6FF</Color>

  <!--  ==================== 语义点缀色 ====================  -->
  <!--
    每个语义色配「淡底 + 深字」一对。
    用途：指标卡的底、徽标、状态标签。
    这是解决"整屏惨白"的关键 —— 用极淡的有色底做区块区分，
    既不破坏克制，又让不同信息块一眼可分。饱和色仅用于文字与数据条。
  -->
  <Color x:Key="Color.Blue.Tint">#FFEFF6FF</Color>
  <Color x:Key="Color.Blue.Text">#FF1D4ED8</Color>

  <Color x:Key="Color.Green.Tint">#FFECFDF5</Color>
  <Color x:Key="Color.Green.Text">#FF047857</Color>

  <Color x:Key="Color.Amber.Tint">#FFFFF7ED</Color>
  <Color x:Key="Color.Amber.Text">#FFB45309</Color>

  <Color x:Key="Color.Violet.Tint">#FFF5F3FF</Color>
  <Color x:Key="Color.Violet.Text">#FF6D28D9</Color>

  <Color x:Key="Color.Rose.Tint">#FFFFF1F2</Color>
  <Color x:Key="Color.Rose.Text">#FFBE123C</Color>

  <!--  状态色  -->
  <Color x:Key="Color.Success">#FF0E9F6E</Color>
  <Color x:Key="Color.Warning">#FFB45309</Color>
  <Color x:Key="Color.Error">#FFDC2626</Color>

  <!--  ==================== 背景与表面 ====================  -->

  <!--  页面底：浅冷灰（不是纯白）  -->
  <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Neutral.5}" />
  <!--  侧边栏：比页面底再深一档，形成分区  -->
  <SolidColorBrush x:Key="Brush.Sidebar" Color="{StaticResource Color.Neutral.10}" />
  <!--  卡片：纯白，从浅灰底上浮起  -->
  <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Neutral.0}" />
  <!--  次级表面（表格斑马纹、输入框内底）  -->
  <SolidColorBrush x:Key="Brush.Surface.Alt" Color="{StaticResource Color.Neutral.5}" />

  <!--  交互态  -->
  <SolidColorBrush x:Key="Brush.Hover" Color="{StaticResource Color.Neutral.10}" />
  <SolidColorBrush x:Key="Brush.Pressed" Color="{StaticResource Color.Neutral.15}" />
  <SolidColorBrush x:Key="Brush.Selected" Color="{StaticResource Color.Accent.Tint}" />

  <!--  ==================== 边框与分隔 ====================  -->
  <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Neutral.20}" />
  <SolidColorBrush x:Key="Brush.Border.Strong" Color="{StaticResource Color.Neutral.30}" />
  <SolidColorBrush x:Key="Brush.Divider" Color="{StaticResource Color.Neutral.15}" />

  <!--  ==================== 文字 ====================  -->
  <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource Color.Neutral.95}" />
  <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Color.Neutral.75}" />
  <SolidColorBrush x:Key="Brush.Text.Tertiary" Color="{StaticResource Color.Neutral.60}" />
  <SolidColorBrush x:Key="Brush.Text.Disabled" Color="{StaticResource Color.Neutral.40}" />
  <SolidColorBrush x:Key="Brush.Text.OnAccent" Color="{StaticResource Color.Neutral.0}" />

  <!--  ==================== 强调与状态 ====================  -->
  <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
  <SolidColorBrush x:Key="Brush.Accent.Hover" Color="{StaticResource Color.Accent.Hover}" />
  <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="{StaticResource Color.Accent.Pressed}" />
  <SolidColorBrush x:Key="Brush.Accent.Subtle" Color="{StaticResource Color.Accent.Tint}" />
  <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
  <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
  <SolidColorBrush x:Key="Brush.Error" Color="{StaticResource Color.Error}" />

  <!--  ==================== 语义点缀（淡底 / 深字） ====================  -->
  <SolidColorBrush x:Key="Brush.Blue.Tint" Color="{StaticResource Color.Blue.Tint}" />
  <SolidColorBrush x:Key="Brush.Blue.Text" Color="{StaticResource Color.Blue.Text}" />
  <SolidColorBrush x:Key="Brush.Green.Tint" Color="{StaticResource Color.Green.Tint}" />
  <SolidColorBrush x:Key="Brush.Green.Text" Color="{StaticResource Color.Green.Text}" />
  <SolidColorBrush x:Key="Brush.Amber.Tint" Color="{StaticResource Color.Amber.Tint}" />
  <SolidColorBrush x:Key="Brush.Amber.Text" Color="{StaticResource Color.Amber.Text}" />
  <SolidColorBrush x:Key="Brush.Violet.Tint" Color="{StaticResource Color.Violet.Tint}" />
  <SolidColorBrush x:Key="Brush.Violet.Text" Color="{StaticResource Color.Violet.Text}" />
  <SolidColorBrush x:Key="Brush.Rose.Tint" Color="{StaticResource Color.Rose.Tint}" />
  <SolidColorBrush x:Key="Brush.Rose.Text" Color="{StaticResource Color.Rose.Text}" />

  <!--  ==================== 数据可视化 ====================  -->
  <SolidColorBrush x:Key="Brush.Chart.Primary" Color="{StaticResource Color.Accent}" />
  <SolidColorBrush x:Key="Brush.Chart.Muted" Color="{StaticResource Color.Accent.Tint}" />
  <SolidColorBrush x:Key="Brush.Chart.Track" Color="{StaticResource Color.Neutral.10}" />

  <!--  ==================== 形状 ====================  -->
  <CornerRadius x:Key="Radius.Small">4</CornerRadius>
  <CornerRadius x:Key="Radius.Medium">6</CornerRadius>
  <CornerRadius x:Key="Radius.Large">10</CornerRadius>
  <CornerRadius x:Key="Radius.Panel">14</CornerRadius>
  <CornerRadius x:Key="Radius.Pill">999</CornerRadius>

  <!--  ==================== 间距 ====================  -->
  <Thickness x:Key="Space.XXS">4</Thickness>
  <Thickness x:Key="Space.XS">8</Thickness>
  <Thickness x:Key="Space.S">12</Thickness>
  <Thickness x:Key="Space.M">16</Thickness>
  <Thickness x:Key="Space.L">24</Thickness>
  <Thickness x:Key="Space.XL">32</Thickness>

  <Thickness x:Key="Padding.Card">20</Thickness>
  <Thickness x:Key="Padding.Control">14,7</Thickness>
  <Thickness x:Key="Padding.Page">24</Thickness>
</ResourceDictionary>
